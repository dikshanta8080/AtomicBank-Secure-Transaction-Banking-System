<%@ page contentType="text/html;charset=UTF-8" %>
<%
    String currentPath = request.getRequestURI().substring(request.getContextPath().length());
%>
<aside class="sidebar">
    <div class="brand">
        <div class="brand-mark">A</div>
        <div class="brand-copy">
            <h1>AtomicBank</h1>
            <p>Admin console</p>
        </div>
    </div>

    <div class="nav-group">
        <div class="nav-label">Overview</div>
        <a class="nav-link <%= currentPath.equals("/AdminDashboard") ? "active" : "" %>" href="<%= request.getContextPath() %>/AdminDashboard">Dashboard</a>
    </div>

    <div class="nav-group">
        <div class="nav-label">Approvals</div>
        <a class="nav-link <%= currentPath.startsWith("/admin/accounts") ? "active" : "" %>" href="<%= request.getContextPath() %>/admin/accounts">Manage Accounts</a>
        <a class="nav-link <%= currentPath.startsWith("/admin/cards") ? "active" : "" %>" href="<%= request.getContextPath() %>/admin/cards">Card Applications</a>
    </div>

    <div class="nav-group">
        <div class="nav-label">Monitor</div>
        <a class="nav-link <%= currentPath.startsWith("/admin/transactions") ? "active" : "" %>" href="<%= request.getContextPath() %>/admin/transactions">All Transactions</a>
        <a class="nav-link <%= currentPath.startsWith("/admin/failed-operations") ? "active" : "" %>" href="<%= request.getContextPath() %>/admin/failed-operations">Failed Operations</a>
    </div>

    <div class="sidebar-footer">
        <strong><%= session.getAttribute("user") != null ? ((com.banking.sathi.model.User) session.getAttribute("user")).getName() : "Admin" %></strong>
        <span><a href="<%= request.getContextPath() %>/logout">Sign out</a></span>
    </div>
</aside>
